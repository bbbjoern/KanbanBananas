#!/bin/sh
# Runs the KanbanBananas CLI with whatever Node.js is available:
# `node` on the PATH, else the Node that VS Code's remote server ships with.
DIR=$(cd "$(dirname "$0")" && pwd)
if command -v node >/dev/null 2>&1; then
  exec node "$DIR/kanban.mjs" "$@"
fi
for n in "$HOME"/.vscode-server/cli/servers/*/server/node \
         "$HOME"/.vscode-server/bin/*/node \
         "$HOME"/.cursor-server/cli/servers/*/server/node \
         "$HOME"/.cursor-server/bin/*/node; do
  if [ -x "$n" ]; then
    exec "$n" "$DIR/kanban.mjs" "$@"
  fi
done
echo "kanban: Node.js not found. Install Node 18 or newer, or open this project once with VS Code Remote." >&2
exit 127
