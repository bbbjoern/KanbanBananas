{
  "name": "@kanban-bananas/core",
  "version": "0.0.0",
  "private": true,
  "description": "Card parsing, patching, validation, ordering and filenames. No vscode import.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fractional-indexing": "^4.0.0",
    "node-diff3": "^3.2.1",
    "yaml": "^2.9.1"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2"
  }
}
