{
  "name": "kanban-bananas",
  "displayName": "KanbanBananas",
  "description": "A kanban board for the markdown cards in your repo: safe writes that never corrupt cards, a live-preview editor, swimlanes, and a CLI + skill so AI agents can update cards safely.",
  "version": "1.0.0",
  "publisher": "Hypertxtorg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bbbjoern/KanbanBananas",
    "directory": "packages/extension"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2A2620",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.devtool/features"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kanbanBananas.openBoard",
        "title": "Open Board",
        "category": "KanbanBananas",
        "icon": "$(project)"
      },
      {
        "command": "kanbanBananas.reload",
        "title": "Reload Board",
        "category": "KanbanBananas",
        "icon": "$(refresh)"
      },
      {
        "command": "kanbanBananas.card.setPriority",
        "title": "Set Priority\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.editLabels",
        "title": "Edit Labels\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.setDueDate",
        "title": "Set Due Date\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.setAssignee",
        "title": "Set Assignee\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.setEpic",
        "title": "Set Epic\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.moveTo",
        "title": "Move to\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.open",
        "title": "Open File",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.installSkill",
        "title": "Install / Update Agent Skill",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.showLog",
        "title": "Show Log",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.showOnBoard",
        "title": "Show on Board",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.renameLabel",
        "title": "Rename Label\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.deleteLabel",
        "title": "Delete Label\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.archive",
        "title": "Archive",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.delete",
        "title": "Delete Card\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.column.moveAll",
        "title": "Move All Cards to\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.column.archiveAll",
        "title": "Archive All Cards\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.lane.new",
        "title": "New Swimlane\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.lane.rename",
        "title": "Rename Swimlane\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.lane.delete",
        "title": "Delete Swimlane\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.restoreArchived",
        "title": "Restore Archived Card\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.renameFilesToPattern",
        "title": "Rename Card Files to Pattern\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.lane.moveUp",
        "title": "Move Swimlane Up",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.lane.moveDown",
        "title": "Move Swimlane Down",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.column.new",
        "title": "New Column\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.column.rename",
        "title": "Rename Column\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.column.color",
        "title": "Change Column Colour\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.column.delete",
        "title": "Delete Column\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.installPreCommitHook",
        "title": "Install Pre-commit Hook (kanban check)",
        "category": "KanbanBananas"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kanbanBananas",
          "title": "KanbanBananas",
          "icon": "media/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "kanbanBananas": [
        {
          "type": "webview",
          "id": "kanbanBananas.sidebar",
          "name": "KanbanBananas"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kanbanBananas.openBoard",
          "when": "view == kanbanBananas.sidebar",
          "group": "navigation"
        },
        {
          "command": "kanbanBananas.reload",
          "when": "view == kanbanBananas.sidebar",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "kanbanBananas.card.setPriority",
          "when": "webviewSection == 'card'",
          "group": "3_fields@0"
        },
        {
          "command": "kanbanBananas.card.editLabels",
          "when": "webviewSection == 'card'",
          "group": "3_fields@1"
        },
        {
          "command": "kanbanBananas.card.setDueDate",
          "when": "webviewSection == 'card'",
          "group": "3_fields@2"
        },
        {
          "command": "kanbanBananas.card.setAssignee",
          "when": "webviewSection == 'card'",
          "group": "3_fields@3"
        },
        {
          "command": "kanbanBananas.card.setEpic",
          "when": "webviewSection == 'card'",
          "group": "3_fields@4"
        },
        {
          "command": "kanbanBananas.card.moveTo",
          "when": "webviewSection == 'card'",
          "group": "2_move@1"
        },
        {
          "command": "kanbanBananas.card.open",
          "when": "webviewSection == 'card'",
          "group": "1_open@1"
        },
        {
          "command": "kanbanBananas.card.archive",
          "when": "webviewSection == 'card'",
          "group": "4_manage@1"
        },
        {
          "command": "kanbanBananas.card.delete",
          "when": "webviewSection == 'card'",
          "group": "4_manage@2"
        },
        {
          "command": "kanbanBananas.column.moveAll",
          "when": "webviewSection == 'column'",
          "group": "1_bulk@1"
        },
        {
          "command": "kanbanBananas.column.archiveAll",
          "when": "webviewSection == 'column'",
          "group": "1_bulk@2"
        },
        {
          "command": "kanbanBananas.lane.rename",
          "when": "webviewSection == 'lane'",
          "group": "1_lane@1"
        },
        {
          "command": "kanbanBananas.lane.delete",
          "when": "webviewSection == 'lane'",
          "group": "1_lane@2"
        },
        {
          "command": "kanbanBananas.lane.moveUp",
          "when": "webviewSection == 'lane' || webviewSection == 'laneNone'",
          "group": "0_order@1"
        },
        {
          "command": "kanbanBananas.lane.moveDown",
          "when": "webviewSection == 'lane' || webviewSection == 'laneNone'",
          "group": "0_order@2"
        },
        {
          "command": "kanbanBananas.column.rename",
          "when": "webviewSection == 'column'",
          "group": "0_column@1"
        },
        {
          "command": "kanbanBananas.column.color",
          "when": "webviewSection == 'column'",
          "group": "0_column@2"
        },
        {
          "command": "kanbanBananas.column.delete",
          "when": "webviewSection == 'column'",
          "group": "2_delete@1"
        }
      ],
      "commandPalette": [
        {
          "command": "kanbanBananas.card.setPriority",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.editLabels",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.setDueDate",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.setAssignee",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.setEpic",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.moveTo",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.open",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.showOnBoard",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.archive",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.delete",
          "when": "false"
        },
        {
          "command": "kanbanBananas.column.moveAll",
          "when": "false"
        },
        {
          "command": "kanbanBananas.column.archiveAll",
          "when": "false"
        },
        {
          "command": "kanbanBananas.lane.rename",
          "when": "false"
        },
        {
          "command": "kanbanBananas.lane.delete",
          "when": "false"
        },
        {
          "command": "kanbanBananas.lane.moveUp",
          "when": "false"
        },
        {
          "command": "kanbanBananas.lane.moveDown",
          "when": "false"
        },
        {
          "command": "kanbanBananas.column.rename",
          "when": "false"
        },
        {
          "command": "kanbanBananas.column.color",
          "when": "false"
        },
        {
          "command": "kanbanBananas.column.delete",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "KanbanBananas",
      "properties": {
        "kanbanBananas.featuresDirectory": {
          "type": "string",
          "default": ".devtool/features",
          "description": "Folder with the card files, relative to the workspace folder."
        },
        "kanbanBananas.columns": {
          "type": "array",
          "default": [
            {
              "id": "backlog",
              "name": "Backlog",
              "color": "#6b7280"
            },
            {
              "id": "todo",
              "name": "To Do",
              "color": "#3b82f6"
            },
            {
              "id": "in-progress",
              "name": "In Progress",
              "color": "#f59e0b"
            },
            {
              "id": "review",
              "name": "Review",
              "color": "#8b5cf6"
            },
            {
              "id": "done",
              "name": "Done",
              "color": "#22c55e"
            }
          ],
          "description": "Board columns, in order. `id` is the status value in the card's frontmatter.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "color": {
                "type": "string"
              }
            }
          }
        },
        "kanbanBananas.compactMode": {
          "type": "boolean",
          "default": false,
          "description": "Smaller cards without the body excerpt."
        },
        "kanbanBananas.addNewCardsToTop": {
          "type": "boolean",
          "default": false,
          "description": "Add new cards to the top of their column instead of the bottom."
        },
        "kanbanBananas.defaultPriority": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "default": "medium",
          "description": "Priority for new cards."
        },
        "kanbanBananas.showPriority": {
          "type": "boolean",
          "default": true,
          "description": "Show the priority badge on cards."
        },
        "kanbanBananas.showAssignee": {
          "type": "boolean",
          "default": true,
          "description": "Show the assignee on cards."
        },
        "kanbanBananas.showDueDate": {
          "type": "boolean",
          "default": true,
          "description": "Show the due date on cards."
        },
        "kanbanBananas.showLabels": {
          "type": "boolean",
          "default": true,
          "description": "Show labels on cards."
        },
        "kanbanBananas.showEpic": {
          "type": "boolean",
          "default": true,
          "description": "Show the epic on cards."
        },
        "kanbanBananas.showFilename": {
          "type": "boolean",
          "default": false,
          "description": "Show the card's filename on cards."
        },
        "kanbanBananas.skillDirectory": {
          "type": "string",
          "default": ".claude/skills",
          "description": "Where \"Install / Update Agent Skill\" puts the kanban skill, relative to the workspace folder. Claude Code reads .claude/skills."
        },
        "kanbanBananas.agentsMayMoveCards": {
          "type": "string",
          "enum": [
            "never",
            "notToDone",
            "anywhere"
          ],
          "default": "notToDone",
          "enumDescriptions": [
            "Agents never move cards between columns; you do. They can still add notes and create cards (not in Done).",
            "Agents may move cards to any column except Done, e.g. to In Progress when starting and to Review when finished. Only you mark cards done.",
            "Agents may move cards to any column, including Done."
          ],
          "markdownDescription": "How far AI agents may move cards. The installed agent skill is rewritten to match when this changes, and the `kanban` CLI enforces it (an agent can only override it with `--force` when you tell it to)."
        },
        "kanbanBananas.showHeaderInEditor": {
          "type": "boolean",
          "default": true,
          "description": "Show a row of card fields (status, priority, labels\u2026) above a card opened in VS Code's editor."
        },
        "kanbanBananas.epicColors": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Colours for epics, e.g. `{ \"Media\": \"#8b5cf6\" }`. Epics not listed get a colour from a fixed palette."
        },
        "kanbanBananas.lanes": {
          "type": "object",
          "default": {},
          "markdownDescription": "Lanes per grouping, shown in this order and even when empty, e.g. `{ \"epic\": [{ \"name\": \"Compose\", \"color\": \"#8b5cf6\" }], \"lane\": [{ \"name\": \"Now\" }, { \"name\": \"Next\" }] }`. Values used on cards but not listed get lanes after these. The board's \"New lane\" adds entries here.",
          "properties": {
            "epic": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "none": {
                    "type": "boolean",
                    "description": "Marks the position of the lane for cards without a value."
                  }
                }
              }
            },
            "assignee": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "none": {
                    "type": "boolean",
                    "description": "Marks the position of the lane for cards without a value."
                  }
                }
              }
            },
            "priority": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "none": {
                    "type": "boolean",
                    "description": "Marks the position of the lane for cards without a value."
                  }
                }
              }
            },
            "lane": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "none": {
                    "type": "boolean",
                    "description": "Marks the position of the lane for cards without a value."
                  }
                }
              }
            }
          },
          "additionalProperties": false
        },
        "kanbanBananas.layout": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical"
          ],
          "default": "horizontal",
          "enumDescriptions": [
            "Columns side by side.",
            "Columns stacked, one below the other."
          ],
          "description": "Layout of the board panel. The sidebar is always stacked."
        },
        "kanbanBananas.hideScrollbars": {
          "type": "boolean",
          "default": false,
          "description": "Hide scrollbars on the board (it still scrolls)."
        },
        "kanbanBananas.filenamePattern": {
          "type": "string",
          "default": "{slug}-{date}",
          "pattern": "^[A-Za-z0-9_{}-]*\\{slug\\}[A-Za-z0-9_{}-]*$",
          "markdownDescription": "Filename for new cards. `{slug}` (required) is the title in lowercase-with-dashes, `{date}` is YYYY-MM-DD. To rename existing cards to a new pattern, run **KanbanBananas: Rename Card Files to Pattern**."
        },
        "kanbanBananas.defaultStatus": {
          "type": "string",
          "default": "",
          "description": "Column for new cards from the N shortcut and new-card commands. Empty: the first column."
        },
        "kanbanBananas.autoUpdateSkill": {
          "type": "boolean",
          "default": true,
          "description": "Update the installed agent skill automatically when a newer extension version brings a newer one. Never replaces a newer skill or one that was edited by hand."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build -w @kanban-bananas/webview && npm run build -w @kanban-bananas/cli && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && vsce package --no-dependencies --out kanban-bananas.vsix --baseImagesUrl https://github.com/bbbjoern/KanbanBananas/raw/HEAD/packages/extension",
    "dev-board": "npm run build -w @kanban-bananas/core && node scripts/dev-board.mjs",
    "test:integration": "npm run build && node test/run.mjs",
    "test": "echo \"extension: unit tests live in core; run test:integration for VS Code tests\"",
    "publish:marketplace": "vsce publish --no-dependencies --packagePath kanban-bananas.vsix",
    "publish:openvsx": "ovsx publish kanban-bananas.vsix"
  },
  "dependencies": {
    "@kanban-bananas/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "@vscode/test-electron": "^3.1.0",
    "ovsx": "^1.2.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "preview": true,
  "keywords": [
    "kanban",
    "markdown",
    "board",
    "task",
    "project management",
    "cards",
    "ai",
    "agents",
    "claude"
  ],
  "homepage": "https://github.com/bbbjoern/KanbanBananas#readme",
  "bugs": {
    "url": "https://github.com/bbbjoern/KanbanBananas/issues"
  }
}
