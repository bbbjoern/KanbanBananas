{
  "name": "kanban-bananas",
  "displayName": "KanbanBananas",
  "description": "A markdown kanban board that never corrupts your cards.",
  "version": "0.1.0",
  "publisher": "hypertxt",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/bbbjoern/KanbanBananas"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.devtool/features"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kanbanBananas.openBoard",
        "title": "Open Board",
        "category": "KanbanBananas",
        "icon": "$(project)"
      },
      {
        "command": "kanbanBananas.reload",
        "title": "Reload Board",
        "category": "KanbanBananas",
        "icon": "$(refresh)"
      },
      {
        "command": "kanbanBananas.card.setPriority",
        "title": "Set Priority\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.editLabels",
        "title": "Edit Labels\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.setDueDate",
        "title": "Set Due Date\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.setAssignee",
        "title": "Set Assignee\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.setEpic",
        "title": "Set Epic\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.moveTo",
        "title": "Move to\u2026",
        "category": "KanbanBananas"
      },
      {
        "command": "kanbanBananas.card.open",
        "title": "Open File",
        "category": "KanbanBananas"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kanbanBananas",
          "title": "KanbanBananas",
          "icon": "media/board.svg"
        }
      ]
    },
    "views": {
      "kanbanBananas": [
        {
          "type": "webview",
          "id": "kanbanBananas.sidebar",
          "name": "Board"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kanbanBananas.openBoard",
          "when": "view == kanbanBananas.sidebar",
          "group": "navigation"
        },
        {
          "command": "kanbanBananas.reload",
          "when": "view == kanbanBananas.sidebar",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "kanbanBananas.card.setPriority",
          "when": "webviewSection == 'card'",
          "group": "3_fields@0"
        },
        {
          "command": "kanbanBananas.card.editLabels",
          "when": "webviewSection == 'card'",
          "group": "3_fields@1"
        },
        {
          "command": "kanbanBananas.card.setDueDate",
          "when": "webviewSection == 'card'",
          "group": "3_fields@2"
        },
        {
          "command": "kanbanBananas.card.setAssignee",
          "when": "webviewSection == 'card'",
          "group": "3_fields@3"
        },
        {
          "command": "kanbanBananas.card.setEpic",
          "when": "webviewSection == 'card'",
          "group": "3_fields@4"
        },
        {
          "command": "kanbanBananas.card.moveTo",
          "when": "webviewSection == 'card'",
          "group": "2_move@1"
        },
        {
          "command": "kanbanBananas.card.open",
          "when": "webviewSection == 'card'",
          "group": "1_open@1"
        }
      ],
      "commandPalette": [
        {
          "command": "kanbanBananas.card.setPriority",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.editLabels",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.setDueDate",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.setAssignee",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.setEpic",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.moveTo",
          "when": "false"
        },
        {
          "command": "kanbanBananas.card.open",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "KanbanBananas",
      "properties": {
        "kanbanBananas.featuresDirectory": {
          "type": "string",
          "default": ".devtool/features",
          "description": "Folder with the card files, relative to the workspace folder."
        },
        "kanbanBananas.columns": {
          "type": "array",
          "default": [
            {
              "id": "backlog",
              "name": "Backlog",
              "color": "#6b7280"
            },
            {
              "id": "todo",
              "name": "To Do",
              "color": "#3b82f6"
            },
            {
              "id": "in-progress",
              "name": "In Progress",
              "color": "#f59e0b"
            },
            {
              "id": "review",
              "name": "Review",
              "color": "#8b5cf6"
            },
            {
              "id": "done",
              "name": "Done",
              "color": "#22c55e"
            }
          ],
          "description": "Board columns, in order. `id` is the status value in the card's frontmatter.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "color": {
                "type": "string"
              }
            }
          }
        },
        "kanbanBananas.compactMode": {
          "type": "boolean",
          "default": false,
          "description": "Smaller cards without the body excerpt."
        },
        "kanbanBananas.addNewCardsToTop": {
          "type": "boolean",
          "default": false,
          "description": "Add new cards to the top of their column instead of the bottom."
        },
        "kanbanBananas.defaultPriority": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "default": "medium",
          "description": "Priority for new cards."
        },
        "kanbanBananas.showPriority": {
          "type": "boolean",
          "default": true,
          "description": "Show the priority badge on cards."
        },
        "kanbanBananas.showAssignee": {
          "type": "boolean",
          "default": true,
          "description": "Show the assignee on cards."
        },
        "kanbanBananas.showDueDate": {
          "type": "boolean",
          "default": true,
          "description": "Show the due date on cards."
        },
        "kanbanBananas.showLabels": {
          "type": "boolean",
          "default": true,
          "description": "Show labels on cards."
        },
        "kanbanBananas.showEpic": {
          "type": "boolean",
          "default": true,
          "description": "Show the epic on cards."
        },
        "kanbanBananas.showFilename": {
          "type": "boolean",
          "default": false,
          "description": "Show the card's filename on cards."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build -w @kanban-bananas/webview && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && vsce package --no-dependencies --skip-license --out kanban-bananas.vsix",
    "dev-board": "npm run build -w @kanban-bananas/core && node scripts/dev-board.mjs",
    "test:integration": "npm run build && node test/run.mjs",
    "test": "vitest run test/unit"
  },
  "dependencies": {
    "@kanban-bananas/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "@vscode/test-electron": "^3.1.0"
  }
}
